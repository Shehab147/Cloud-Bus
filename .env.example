# Copy to .env for the API and frontend/.env for browser-only Vite settings.
NODE_ENV=development
PORT=4000
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://localhost:5173
CAMPUS_TIMEZONE=Africa/Cairo
DATA_FILE=backend/data/campus-bus.json
TRUST_PROXY=0
LOG_LEVEL=info
TURNSTILE_SECRET=
# Comma-separated frontend hostnames for this deployment. Do not include localhost in production.
TURNSTILE_HOSTNAMES=a2cloud.online
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional: other services to probe on the admin dashboard, as name=url pairs (comma-separated).
# Example: routes=http://10.0.0.11:4001/api/health,timetables=http://10.0.0.12:4002/api/health
HEALTH_TARGETS=
# Optional browser key; Leaflet/OpenStreetMap is the default and needs no key.
VITE_GOOGLE_MAPS_API_KEY=
# Optional CloudWatch agent configuration.
CLOUDWATCH_LOG_GROUP=

