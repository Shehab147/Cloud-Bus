# Copy to .env for the API and frontend/.env for browser-only Vite settings.
NODE_ENV=development
PORT=4000
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://localhost:5173
CAMPUS_TIMEZONE=Africa/Cairo
DATA_FILE=backend/data/campus-bus.json
TRUST_PROXY=0
LOG_LEVEL=info
# Optional browser key; Leaflet/OpenStreetMap is the default and needs no key.
VITE_GOOGLE_MAPS_API_KEY=
# Optional CloudWatch agent configuration.
CLOUDWATCH_LOG_GROUP=

