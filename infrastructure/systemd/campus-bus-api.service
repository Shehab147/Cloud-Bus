[Unit]
Description=Campus Bus Tracker API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=campus-bus
Group=campus-bus
WorkingDirectory=/var/www/a2cloud/backend
# systemd reads this protected file before dropping privileges to campus-bus.
EnvironmentFile=/var/www/a2cloud/.env
ExecStart=/usr/bin/node dist/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/campus-bus
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
