{
  "agent": {"metrics_collection_interval": 60, "run_as_user": "cwagent"},
  "logs": {
    "logs_collected": {
      "files": {"collect_list": [
        {"file_path": "/var/log/nginx/access.log", "log_group_name": "${CLOUDWATCH_LOG_GROUP}", "log_stream_name": "nginx-access", "retention_in_days": 30},
        {"file_path": "/var/log/nginx/error.log", "log_group_name": "${CLOUDWATCH_LOG_GROUP}", "log_stream_name": "nginx-error", "retention_in_days": 30}
      ]}
    }
  },
  "metrics": {
    "append_dimensions": {"InstanceId": "${aws:InstanceId}"},
    "metrics_collected": {"cpu": {"measurement": ["cpu_usage_idle"], "totalcpu": true}, "mem": {"measurement": ["mem_used_percent"]}, "disk": {"measurement": ["used_percent"], "resources": ["/"]}}
  }
}
